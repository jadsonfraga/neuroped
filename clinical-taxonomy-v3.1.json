  "filter_contract": {
    "anti_pattern_forbidden": "if (item.tipo === 'teste') { ... }",
    "engines_must_be_isolated": true,
    "panels": {
      "testes-diretos.html":        { "engine": "DirectTestEngine", "type": "direct_test", "category": "clinical_application" },
      "escalas-questionarios.html": { "engine": "ScaleEngine",      "type": "scale",       "category": "pre_consultation" },
      "diarios-clinicos.html":      { "engine": "DiaryEngine",      "type": "diary",       "category": "longitudinal_followup" }
