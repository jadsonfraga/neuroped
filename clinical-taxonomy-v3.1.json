{
  "$schema": "https://neuroped.io/schemas/clinical-taxonomy.v3.1.json",
  "version": "3.1.0",
  "author": "Dr. Jadson Fraga · CRM-PE 25227 · RQE 17756",
  "last_reviewed": "2026-06-03",
  "description": "Taxonomia clínica V3.1 — schema completo com tipagem forte (JSDoc-compatível). Cada instrumento DEVE possuir 9 campos canônicos. Estende V3 com application_mode, longitudinal, purpose e requires_training como campos de primeira classe.",

  "required_fields_per_instrument": [
    "id",
    "name",
    "type",
    "subtype",
    "category",
    "application_mode",
    "respondent",
    "longitudinal",
    "requires_training",
    "estimated_minutes",
    "purpose"
  ],

  "field_definitions": {
    "id":                { "type": "string",  "pattern": "^(td|esc|diar|ofc|fam)[a-z0-9-]+$", "description": "ID canônico com prefixo do tipo" },
    "name":              { "type": "string",  "minLength": 3 },
    "type":              { "type": "enum",    "values": ["direct_test", "scale", "diary"] },
    "subtype":           { "type": "string",  "description": "Subtipo dentro do type — vide types.allowed_subtypes" },
    "category":          { "type": "enum",    "values": ["clinical_application", "pre_consultation", "longitudinal_followup"] },
    "application_mode":  { "type": "enum",    "values": ["presencial", "remoto", "hibrido", "recorrente"] },
    "respondent":        { "type": "enum",    "values": ["clinico", "clinico_observacao", "familia", "escola", "autoteste_adolescente", "familia_e_escola", "cuidador", "paciente_em_desempenho"] },
    "longitudinal":      { "type": "boolean", "description": "true só para diary" },
    "requires_training": { "type": "boolean", "description": "true bloqueia pré-consulta" },
    "estimated_minutes": { "type": "number",  "min": 0, "max": 240 },
    "purpose":           { "type": "enum",    "values": ["triagem", "confirmacao", "acompanhamento", "monitoramento", "resposta_tratamento", "rastreio_risco"] }
  },

  "types": {
    "direct_test": {
      "label": "Teste direto",
      "icon": "🎯",
      "category_canonical": "clinical_application",
      "application_mode_default": "presencial",
      "longitudinal_default": false,
      "requires_training_default": true,
      "ui_panel": "testes-diretos.html",
      "engine": "DirectTestEngine",
      "allowed_subtypes": [
        "academic", "cognitive_screening", "phonological_awareness", "naming",
        "letter_recognition", "motor_task", "neuropsych_brief",
        "language_production", "executive_function_task", "reading", "writing", "math"
      ],
      "ux_principles": ["fullscreen", "cronometro_opcional", "pontuacao_imediata", "foco_clinico"]
    },
    "scale": {
      "label": "Escala / Questionário / Inventário",
      "icon": "📋",
      "category_canonical": "pre_consultation",
      "application_mode_default": "remoto",
      "longitudinal_default": false,
      "requires_training_default": false,
      "ui_panel": "escalas-questionarios.html",
      "engine": "ScaleEngine",
      "allowed_subtypes": [
        "behavioral", "developmental", "attention", "social", "emotional",
        "anxiety", "depression", "sensory", "adaptive", "school",
        "obsessive_compulsive", "sleep_screening", "feeding_screening", "risk"
      ],
      "ux_principles": ["compartilhamento_remoto", "barra_de_progresso", "linguagem_familiar", "export_pdf"]
    },
    "diary": {
      "label": "Diário clínico",
      "icon": "📔",
      "category_canonical": "longitudinal_followup",
      "application_mode_default": "recorrente",
      "longitudinal_default": true,
      "requires_training_default": false,
      "ui_panel": "diarios-clinicos.html",
      "engine": "DiaryEngine",
      "allowed_subtypes": [
        "sleep", "feeding", "behavior", "seizure", "bowel", "school_daily",
        "medication", "aggression", "sensory", "mood", "headache", "tics"
      ],
      "ux_principles": ["calendario", "timeline", "graficos_evolutivos", "export_csv_pdf", "recorrencia"]
    }
  },

  "categories": {
    "clinical_application":   { "label": "Aplicação clínica presencial", "engine": "DirectTestEngine" },
    "pre_consultation":       { "label": "Pré-consulta",                 "engine": "ScaleEngine" },
    "longitudinal_followup":  { "label": "Acompanhamento longitudinal",  "engine": "DiaryEngine" }
  },

  "pre_consultation_filter": {
    "rule": "Bloqueia escalas que exigem treinamento clínico, observação estruturada, entrevista profissional, >20min, ou possuem gate diagnóstico.",
    "blocklist": ["ofc-vineland-3", "ofc-cars-2", "ofc-conners-3", "ofc-gmfcs-er", "ofc-cssrs", "ofc-asq-suicide", "ofc-cbcl"],
    "allowlist": [
      "ofc-mchat-rf", "ofc-snap-iv", "ofc-vanderbilt", "ofc-sdq",
      "ofc-phq-a", "ofc-gad-7", "ofc-bisq", "ofc-srs-2", "ofc-asq-3",
      "ofc-scared", "ofc-cdi-2", "esc-abc-comportamento", "esc-perfil-sensorial",
      "fam-12-36-tea-primeiros-sinais"
    ]
  },

