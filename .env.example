# NeuroPed SDG — variaveis de ambiente (modelo)
#
# Este arquivo e versionado e NAO deve conter valores reais.
# Para producao, configure os secrets em:
#   Cloudflare Pages > Settings > Environment variables (Encrypt)
# ou via:
#   wrangler pages secret put <NAME> --project-name neuroped

# Token usado pelo endpoint GET /api/submissions (header X-Clinic-Token).
# Gere com:  openssl rand -hex 32
APP_TOKEN=

# database_id retornado por `wrangler d1 create neuroped-db`.
# Copie tambem para wrangler.toml -> d1_databases[0].database_id
NEUROPED_D1_DATABASE_ID=

# === Backend Supabase (opcional, coexiste com D1) ===
# Veja SUPABASE.md para configurar. Estes nao sao secrets de runtime do
# servidor; vao no cloud-config.js (browser-side). A anon key e PUBLICA.
# Mantenha para referencia local apenas.
SUPABASE_URL=
SUPABASE_ANON_KEY=
