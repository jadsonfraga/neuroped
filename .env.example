# NeuroPed EDJ — ambiente seguro
# Copie para .env.local no desenvolvimento.

# demo: não grava dados clínicos e bloqueia funções sensíveis.
# production: exige backend Supabase configurado e políticas RLS ativas.
VITE_APP_ENV=demo
VITE_APP_BASE_PATH=/neuroped/

# Supabase — obrigatório apenas para VITE_APP_ENV=production
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Nunca coloque service_role keys no frontend.
# Nunca use CPF como senha.
# Nunca grave dados clínicos em endpoints públicos sem autenticação.
