# =====================================================================
# NeuroPed EDJ - variaveis de ambiente
#
# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite .env real no git.
# =====================================================================

# ----- Ambiente -----
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# ----- Zona de implantação (público × médico) — ver docs/DEPLOY-ZONA-MEDICA.md
# full   = host único: rota pública livre + PIN nas rotas médicas (padrão)
# public = host das famílias: sem PIN, só conteúdo educativo aberto
# medical= subdomínio médico: app completo (proteja com Cloudflare Access no edge)
VITE_ZONE=full
# URL do subdomínio médico (usada para linkar da zona pública p/ a área médica)
VITE_MEDICAL_URL=

# ----- Trava de domínio (anticópia / anti-rehost) — ver client/src/lib/domainGuard.ts
# Lista opcional de hosts extras autorizados a rodar o app (separados por vírgula).
# Os domínios oficiais (neuroped.pages.dev e superneuroped.vercel.app) e
# localhost já são liberados por padrão. Use apenas se adicionar um domínio novo.
# Ex.: VITE_ALLOWED_HOSTS=app.neuroped.com.br,www.neuroped.com.br
VITE_ALLOWED_HOSTS=

# =====================================================================
# BANCO DE DADOS
# =====================================================================

# Dev: SQLite local (default se DATABASE_URL nao definido)
DATABASE_PATH=./neuroped.db

# Produção usa Cloudflare D1 pelos workflows oficiais. DATABASE_URL/Postgres
# permanece fora da topologia suportada e não deve ser configurado em produção.


# =====================================================================
# CRIPTOGRAFIA — OBRIGATORIO em producao
# =====================================================================

# Chave mestra para AES-GCM 256 (campos sensiveis: nome, CPF, notas).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Minimo 32 caracteres. Trocar invalida TODOS os dados criptografados.
NEUROPED_MASTER_KEY=__GERAR_48_BYTES_BASE64__

# Secret JWT (assina tokens de acesso).
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
NEUROPED_JWT_SECRET=__GERAR_64_BYTES_BASE64__

# ----- SaaS Phase 1 / Clinical Core LIVE -----
# HARD STOP: manter false até migração, restore, isolamento e observabilidade
# estarem validados. O código LIVE falha fechado quando estiver false.
CLINICAL_LIVE_ENABLED=false

# Chave atual de dados clínicos LIVE. Deve ser independente de JWT e da chave
# mestra legada. O backend deriva uma chave AES-256-GCM diferente por clínica.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
CLINICAL_DATA_KEY=__GERAR_48_BYTES_BASE64_INDEPENDENTE__
CLINICAL_DATA_KEY_ID=k1

# Durante rotação, mantenha a chave anterior apenas no período de re-encriptação.
# Remova depois que todos os registros tiverem encryption_version da chave nova.
CLINICAL_DATA_KEY_PREVIOUS=
CLINICAL_DATA_KEY_PREVIOUS_ID=

# Chave estável exclusiva para blind indexes HMAC (reconciliação/deduplicação).
# NÃO reutilizar CLINICAL_DATA_KEY e NÃO rotacionar junto com a data key sem
# plano explícito de recomputação dos índices.
CLINICAL_INDEX_KEY=__GERAR_48_BYTES_BASE64_INDEPENDENTE__

# =====================================================================
# OBJECT STORAGE — para upload de laudos, exames, audios
# =====================================================================

# Provedores S3-compatible:
#   supabase  - Supabase Storage (sa-east-1, recomendado para BR/LGPD)
#   r2        - Cloudflare R2 (zero egress fees)
#   s3        - AWS S3 sa-east-1 (premium)
#   b2        - Backblaze B2 (alternativa barata)
#   minio     - MinIO self-hosted (dev local)
STORAGE_PROVIDER=supabase

# Endpoint S3-compatible. Templates por provedor:
#   supabase: https://<PROJECT_REF>.supabase.co/storage/v1/s3
#   r2:       https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   s3:       (deixar vazio, usa endpoint padrao da AWS)
#   b2:       https://s3.<REGION>.backblazeb2.com
#   minio:    http://localhost:9000
STORAGE_ENDPOINT=https://__PROJECT_REF__.supabase.co/storage/v1/s3
STORAGE_REGION=sa-east-1
STORAGE_BUCKET=neuroped-files

# Credenciais de acesso (S3-compatible).
# Para Supabase: pegar em Project Settings -> API -> Storage S3 keys.
# Para R2: criar API token em R2 dashboard.
# Para AWS: criar usuario IAM com policy de S3 + access keys.
STORAGE_ACCESS_KEY=__SUA_ACCESS_KEY__
STORAGE_SECRET_KEY=__SUA_SECRET_KEY__

# Force path style: "true" para R2, MinIO; "false" (default) para AWS, Supabase.
STORAGE_FORCE_PATH_STYLE=false

# Tamanho maximo de upload (em MB)
MAX_FILE_SIZE_MB=50

# =====================================================================
# Bootstrap admin (apenas no primeiro deploy)
# Apos criar admin pelo primeiro login, REMOVA estas linhas.
# O par existente nunca e sobrescrito por padrao. Para uma migracao unica
# explicitamente autorizada, defina ADMIN_FORCE_PASSWORD_RESET=true e remova-o
# imediatamente depois da execucao bem-sucedida.
# =====================================================================
ADMIN_EMAIL=admin@drjadsonfraga.com.br
ADMIN_NAME=Dr. Jadson Fraga
ADMIN_INITIAL_PASSWORD=__SENHA_INICIAL_FORTE_SUBSTITUIR__
ADMIN_FORCE_PASSWORD_RESET=false

# =====================================================================
# CORS (origens permitidas, separadas por virgula)
# Em dev pode usar localhost; em prod restrinja ao dominio publico.
# =====================================================================

CORS_ORIGINS=http://localhost:5000,http://localhost:5173

# =====================================================================
# SMTP (envio de email transacional)
# =====================================================================

# Recomendacoes:
#   Brevo (sendinblue):   smtp-relay.brevo.com:587  (free 300/dia)
#   Resend:               smtp.resend.com:587       (free 3000/mes)
#   Amazon SES sa-east-1: email-smtp.sa-east-1.amazonaws.com:587

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=__SEU_USUARIO_SMTP__
SMTP_PASSWORD=__SUA_SENHA_SMTP__
SMTP_FROM=NeuroPed EDJ <noreply@drjadsonfraga.com.br>

# =====================================================================
# Observabilidade (opcional)
# =====================================================================

# SENTRY_DSN=
# LOG_LEVEL=info