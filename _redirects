#
# RESOLVE BUG P1 do PR #23 (chatgpt-codex-connector review):
#   Catch-all sozinho ("/* /index.html 200") quebrava assets, .html
#   específicos e PWA files em produção. Esta versão é escopada.
#
# ORDEM IMPORTA: regras avaliadas top-down, primeira match vence.
# Comentários começam com #, ignorados pelo parser.
# Documentação: https://developers.cloudflare.com/pages/configuration/redirects/
# =====================================================================

# ─────────────────────────────────────────────────────────────────────
# 1. PROXY DE API — Cloudflare Pages Functions
# ─────────────────────────────────────────────────────────────────────
/api/*                          /api/:splat                       200
/.well-known/*                  /.well-known/:splat               200

# ─────────────────────────────────────────────────────────────────────
# 2. ASSETS BUILD (Vite/React) — hashed, defensivo
# ─────────────────────────────────────────────────────────────────────
/assets/*                       /assets/:splat                    200
/icons/*                        /icons/:splat                     200
/img/*                          /img/:splat                       200
/fonts/*                        /fonts/:splat                     200

# ─────────────────────────────────────────────────────────────────────
# 3. PWA / SW / MANIFEST — sempre devem servir o arquivo real
# ─────────────────────────────────────────────────────────────────────
/sw.js                          /sw.js                            200
/manifest.json                  /manifest.json                    200
/manifest.webmanifest           /manifest.webmanifest             200
/robots.txt                     /robots.txt                       200
/sitemap.xml                    /sitemap.xml                      200
/favicon.ico                    /favicon.ico                      200
/icon-192.png                   /icon-192.png                     200
/icon-512.png                   /icon-512.png                     200

