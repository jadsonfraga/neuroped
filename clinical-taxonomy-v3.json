{
  "$schema": "https://neuroped.io/schemas/clinical-taxonomy.v3.json",
  "version": "3.0.0",
  "author": "Dr. Jadson Fraga · CRM-PE 25227 · RQE 17756",
  "last_reviewed": "2026-06-03",
  "description": "Taxonomia canônica V3 — separação obrigatória de TESTES DIRETOS, ESCALAS/QUESTIONÁRIOS e DIÁRIOS CLÍNICOS. Cada item do catálogo deve possuir os três campos {type, subtype, category}. Categorias jamais compartilham o mesmo filtro lógico.",

  "types": {
    "direct_test": {
      "label": "Teste direto",
      "icon": "🎯",
      "category_canonical": "clinical_application",
      "description": "Instrumento aplicado diretamente NA criança em consulta presencial, com desempenho em tempo real e observação clínica direta.",
      "characteristics": ["presencial", "desempenho_em_tempo_real", "observacao_direta", "criança_é_avaliada_ativamente"],
      "respondent_must_be": ["clinico", "clinico_observacao", "criança_em_desempenho"],
      "allowed_subtypes": [
        "academic",
        "cognitive_screening",
        "phonological_awareness",
        "naming",
        "letter_recognition",
        "motor_task",
        "neuropsych_brief",
        "language_production",
        "executive_function_task"
      ],
      "ui_panel": "testes-diretos.html",
      "ux_focus": "aplicação rápida presencial"
    },

    "scale": {
      "label": "Escala / Questionário / Inventário",
      "icon": "📋",
      "category_canonical": "pre_consultation",
      "description": "Coleta indireta estruturada respondida por pais, escola ou autoavaliação adolescente. Usada para triagem e apoio diagnóstico antes/entre consultas.",
      "characteristics": ["respondente_indireto", "coleta_assíncrona", "rastreio_clínico", "preenchível_remotamente"],
      "respondent_must_be": ["familia", "escola", "autoteste", "familia_e_escola", "autoteste_adolescente"],
      "allowed_subtypes": [
        "behavioral",
        "developmental",
        "attention",
        "social",
        "emotional",
        "anxiety",
        "depression",
        "sensory",
        "adaptive",
        "school",
        "obsessive_compulsive",
        "sleep_screening",
        "feeding_screening",
        "risk"
      ],
      "ui_panel": "escalas-questionarios.html",
      "ux_focus": "triagem e pré-consulta"
    },

    "diary": {
      "label": "Diário clínico",
      "icon": "📔",
      "category_canonical": "longitudinal_followup",
      "description": "Registro recorrente longitudinal preenchido pelos cuidadores ou pelo paciente ao longo do tempo. Análise temporal e gráficos evolutivos.",
      "characteristics": ["recorrente", "temporal", "calendário", "linha_do_tempo", "grafico_evolutivo"],
      "respondent_must_be": ["familia", "cuidador", "escola", "paciente", "automonitoramento"],
      "allowed_subtypes": [
        "sleep",
        "feeding",
        "behavior",
        "seizure",
        "bowel",
        "school_daily",
        "medication",
        "aggression",
        "sensory",
        "mood",
        "headache",
        "tics"
      ],
      "ui_panel": "diarios-clinicos.html",
      "ux_focus": "acompanhamento evolutivo longitudinal"
    }
  },

  "categories": {
    "clinical_application": {
      "label": "Aplicação clínica presencial",
      "panel": "testes-diretos.html"
    },
    "pre_consultation": {
      "label": "Pré-consulta",
      "panel": "escalas-questionarios.html"
    },
    "longitudinal_followup": {
      "label": "Acompanhamento longitudinal",
      "panel": "diarios-clinicos.html"
    }
  },

