  "filter_contract": {
    "rule": "Cada painel de UI deve filtrar APENAS por seu type.canonical. Categorias NUNCA devem misturar.",
    "panels": {
      "testes-diretos.html":        { "type": "direct_test", "category": "clinical_application" },
      "escalas-questionarios.html": { "type": "scale",       "category": "pre_consultation" },
      "diarios-clinicos.html":      { "type": "diary",       "category": "longitudinal_followup" }
    },
    "forbidden_anti_patterns": [
      "if (item.tipo === 'teste') { ... }   // não diferencia",
      "filter por palavra-chave no label    // produz falsos positivos",
      "mostrar todos os instrumentos em uma única lista"
    ]
  }
}
