# wrangler.toml.example â€” NeuroPed EDJ
# Copie para wrangler.toml e configure com seus valores.
# NUNCA commite wrangler.toml com tokens reais.
# ReferÃªncia: https://developers.cloudflare.com/workers/wrangler/configuration/

name = "neuroped-edj"
main = "functions/_worker.js"
compatibility_date = "2024-01-01"
compatibility_flags = ["nodejs_compat"]

# â”€â”€ Cloudflare Pages (frontend) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# O build do frontend vai para a pasta dist/public
# Configure no Cloudflare Dashboard: Pages > Project > Settings > Build

# â”€â”€ D1 â€” Banco de Dados SQLite na Borda â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Alternativa ao PostgreSQL â€” 100% gratuito no plano Workers Free
# Limite: 5GB armazenamento, 5M leituras/dia, 100k escritas/dia
[[d1_databases]]
binding = "DB"
database_name = "neuroped-prod"
database_id = "__SEU_DATABASE_ID__"
# Para criar: wrangler d1 create neuroped-prod

# â”€â”€ KV â€” Cache de Dados NÃ£o SensÃ­veis â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Use APENAS para dados nÃ£o sensÃ­veis (configuraÃ§Ãµes, templates, etc.)
# NUNCA armazene dados de pacientes em KV sem criptografia
[[kv_namespaces]]
binding = "CACHE"
id = "__SEU_KV_NAMESPACE_ID__"
# Para criar: wrangler kv:namespace create CACHE

# â”€â”€ Variables de Ambiente â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Secrets devem ser configurados via: wrangler secret put NOME_DO_SECRET
# Nunca coloque secrets diretamente aqui
[vars]
NODE_ENV = "production"
APP_VERSION = "2.0.0"
CORS_ORIGINS = "https://neuroped.pages.dev,https://seudominio.com.br"

# Secrets (configurar via CLI, nÃ£o neste arquivo):
# wrangler secret put NEUROPED_MASTER_KEY
# wrangler secret put NEUROPED_JWT_SECRET

# â”€â”€ Workers AI (para embeddings â€” plano gratuito) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# 10.000 neurÃ´nios/dia gratuito
# [ai]
# binding = "AI"

# â”€â”€ Vectorize (para busca semÃ¢ntica â€” plano pago $0.01/1k vetores) â”€
# [[vectorize]]
# binding = "VECTORIZE"
# index_name = "neuroped-memory"
# dimensions = 768
# metric = "cosine"

# â”€â”€ Routes â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
