index 2dc2e61660e10e8ae32540ba96658a49ef3c3428..f2ffb77d76240fe8aade9099c5cfce61d68fdb28 100644
--- a/client/src/styles/premium-app-shell-v12.css
+++ b/client/src/styles/premium-app-shell-v12.css
@@ -125,7 +125,7 @@ main,
 }
 
 /* ───────────────────────── Shell desktop ───────────────────────── */
-@media screen and (min-width: 768px) {
+@media screen and (min-width: 1024px) {
   aside[aria-label="Menu de navegação"] {
     background:
       linear-gradient(180deg, hsl(var(--sidebar) / 0.985), hsl(var(--sidebar) / 0.94)) !important;
@@ -348,12 +348,12 @@ a[class*="inline-flex"]:active {
 }
 
 /* ───────────────────────── Mobile: dock + tela nativa ───────────────────────── */
-@media screen and (max-width: 767px) {
+@media screen and (max-width: 1023px) {
   body.np-mobile-dock-active {
     padding-bottom: calc(5.4rem + var(--np-safe-bottom));
   }
 
-  header.fixed.md\:hidden {
+  header.fixed.lg\:hidden {
     background:
       linear-gradient(180deg, hsl(var(--card) / 0.97), hsl(var(--card) / 0.88)) !important;
     border-bottom-color: hsl(var(--border) / 0.58) !important;
@@ -432,6 +432,90 @@ a[class*="inline-flex"]:active {
   }
 }
 
+
+/* ───────────────────────── Composição responsiva verificável ───────────────────────── */
+@media screen and (min-width: 768px) and (max-width: 1023px) {
+  #main-content > div:last-child {
+    padding-left: 1.25rem !important;
+    padding-right: 1.25rem !important;
+  }
+
+  [data-testid="mobile-primary-dock"] {
+    left: 50% !important;
+    right: auto !important;
+    width: min(40rem, calc(100vw - 2rem));
+    transform: translateX(-50%);
+  }
+
+  [data-testid="mobile-primary-dock"] nav {
+    min-height: 4.15rem;
+    border-radius: 1.65rem !important;
+  }
+
+  [data-testid="mobile-primary-dock"] button {
+    min-height: 3.7rem !important;
+  }
+}
+
+/* Cinco atalhos sem “célula órfã”: 2+2+1 vira 2+2+largura total e, em telas
+   largas, 3+2 centralizado pela malha de seis colunas. */
+@media screen and (min-width: 640px) and (max-width: 1279px) {
+  .np-home-flow-grid > a:last-child {
+    grid-column: 1 / -1;
+  }
+}
+
+@media screen and (min-width: 1280px) {
+  .np-home-flow-grid {
+    grid-template-columns: repeat(6, minmax(0, 1fr)) !important;
+  }
+
+  .np-home-flow-grid > a {
+    grid-column: span 2;
+  }
+
+  .np-home-flow-grid > a:nth-last-child(-n + 2) {
+    grid-column: span 3;
+  }
+}
+
+/* Faixas horizontais tornam o gesto explícito e previsível sem encolher texto. */
+.np-horizontal-chips,
+.np-prontuario-tabs {
+  scrollbar-width: none;
+  scroll-snap-type: x proximity;
+  overscroll-behavior-inline: contain;
+  -webkit-overflow-scrolling: touch;
+}
+
+.np-horizontal-chips::-webkit-scrollbar,
+.np-prontuario-tabs::-webkit-scrollbar {
+  display: none;
+}
+
+.np-horizontal-chips > *,
+.np-prontuario-tabs > [role="tab"] {
+  scroll-snap-align: start;
+}
+
+.np-legal-disclosure > summary {
+  list-style: none;
+}
+
+.np-legal-disclosure > summary::-webkit-details-marker {
+  display: none;
+}
+
+@media screen and (max-width: 639px) {
+  .np-prontuario-tabs {
+    padding-right: 1rem;
+  }
+
+  [data-testid="prontuario-header"] {
+    box-shadow: 0 12px 30px -28px hsl(var(--foreground) / 0.55);
+  }
+}
+
 /* ───────────────────────── Mascotes: integração de interface ───────────────────────── */
 .np-mascot-layer {
   --np-mascot-halo: hsl(var(--primary) / 0.13);
@@ -517,8 +601,9 @@ a[class*="inline-flex"]:active {
     linear-gradient(135deg, hsl(0 0% 100% / 0.2), transparent 45%);
 }
 
-@media screen and (max-width: 767px) {
+@media screen and (max-width: 1023px) {
   .np-mascot-chip,
+  .np-mascot-nino,
   .np-mascot-legacy {
     display: none !important;
   }
