+/* Flow OS — continuidade de navegação mobile e tablet.
+ * A camada não oculta conteúdo: reserva espaço para o dock fixo e mantém a
+ * única ajuda flutuante fora da área de navegação. */
 
 /* Ownership aditivo: fechar um overlay remove apenas a sua classe e nunca
  * libera outro overlay ainda aberto. Evita restauração cruzada de overflow. */
@@ -11,21 +11,18 @@ body.np-legal-gate-open {
