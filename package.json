    "start": "cross-env NODE_ENV=production node dist/index.cjs",
    "check": "tsc --noEmit",
    "test:clinical": "node --import tsx tests/clinical/test-clinical.mjs",
    "test:ownership": "node --import tsx tests/unit/ownership.test.ts",
