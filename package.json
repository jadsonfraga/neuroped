    "verify": "npm run verify:release",
    "lint": "eslint . --ext ts,tsx --max-warnings=0",
    "test:notes": "node --import tsx tests/unit/notes-engine.test.ts",
    "test:cognitive": "node --import tsx tests/unit/cognitive-lab.test.ts",
    "test:operations": "node --import tsx tests/unit/operations-contract.test.ts && node tests/unit/operations-integration-static.test.mjs",
    "test:no-fake-clinical-write": "node --import tsx tests/unit/no-fake-clinical-write.test.ts"
