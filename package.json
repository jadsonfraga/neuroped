{
  "name": "neuroped-edj",
  "version": "1.0.0",
  "private": true,
  "description": "NeuroPed EDJ - Frontend estatico com backend Cloudflare Pages Functions e D1",
  "scripts": {
    "dev": "wrangler pages dev .",
    "db:schema": "wrangler d1 execute neuroped-db --file=./schema.sql --remote",
    "test:static": "node scripts/test-static.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "npm run test:static && npm run typecheck",
    "predeploy": "node scripts/predeploy-check.mjs && npm test",
    "deploy": "wrangler pages deploy . --project-name neuroped --branch main"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "wrangler": "latest",
    "typescript": "latest"
  }
}
