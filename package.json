    "audit:lighthouse": "node scripts/audit-lighthouse.mjs",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "audit:a11y:full": "cross-env A11Y_FULL=1 node scripts/audit-a11y.mjs",
    "audit:design": "node scripts/audit-design.mjs",
    "audit:scales:clinical": "node --import tsx scripts/auditClinicaEscalas.js",
    "audit:scales:full": "node --import tsx scripts/auditEscalas.js",
    "audit:navigation": "node scripts/guards/audit-navigation-routes.mjs",
    "audit:inventory": "node scripts/guards/audit-inventory.mjs",
    "audit:assets": "node scripts/guards/audit-visual-assets.mjs",
    "audit:access": "node scripts/guards/audit-access-policy.mjs",
