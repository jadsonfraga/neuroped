{
  "name": "neuroped-edj",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NeuroPed EDJ — PWA seguro para apoio educacional em neuropediatria.",
  "scripts": {
    "dev": "vite",
    "preflight": "node scripts/preflight.mjs",
    "build": "npm run preflight && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "verify": "npm run preflight && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "latest",
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "pdf-lib": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "globals": "latest",
    "typescript-eslint": "latest"
  },
  "engines": {
    "node": ">=20"
  }
}
